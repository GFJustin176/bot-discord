# Credenciais Obrigatórias do Bot Discord
DISCORD_TOKEN=seu_token_do_bot_aqui
DISCORD_CLIENT_ID=id_da_aplicacao_do_bot_aqui
# Opcional: ID do servidor para registro instantâneo de Slash Commands
DISCORD_GUILD_ID=

# Prefixo para comandos por mensagem no chat (ex: !play, !skip)
COMMAND_PREFIX=!

# Limite máximo de músicas na fila (padrão: 25000)
MAX_QUEUE_SIZE=25000

# Limite máximo (em MB) para manter uma faixa em memória RAM no pré-buffer (padrão: 25 MB)
MAX_RAM_BUFFER_MB=25

# Credenciais do Spotify (Modo Híbrido: se vazias, usa fallback automático via embed/token anônimo)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Caminhos opcionais para os binários (se vazios, detecta automaticamente no PATH do sistema)
YTDLP_PATH=
FFMPEG_PATH=

