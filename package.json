{
  "name": "bot-discord-musica",
  "version": "1.0.0",
  "description": "Bot pessoal de música para Discord com fila de 25.000 faixas, pré-buffer em RAM e demux WebM/Opus direto",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/bot/deploy-commands.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^1.2.1",
    "@snazzah/davey": "^0.1.9",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sodium-native": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}

